// Test suites for lrcalc.lib, the interface to the Littlewood-Richardson
// Calculator by Anders Buch.  Run it like any Singular script, e.g.
//   Singular lrcalc.lib.test.sng
//
// NOTE: all computational procs of lrcalc.lib delegate to the external
// programs `lrcalc` and `schubmult`.  On the Linux CI runners these are
// installed via apt (package lrcalc); on systems where they are missing
// (e.g. the macOS runners -- there is no Homebrew formula) the suite
// below is skipped gracefully: zero test cases are reported instead of
// false failures.
//
// The expected values below were verified against lrcalc 1.2, the same
// version the Debian/Ubuntu package ships.
LIB "test.lib";
LIB "lrcalc.lib";

// probe: do the external programs exist and actually run?
int lrcalcAvailable =
  (system("sh",
     "lrcalc coef 1 - 1 - 1 >/dev/null 2>&1 && schubmult 1 - 1 >/dev/null 2>&1")
   == 0);

// helpers shared by the test cases below: search the result lists of
// LRskew / LRmult / LRschubmult (entries are list(coefficient, partition))
// and of LRcoprod (entries are list(coefficient, partition, partition))
proc hasEntry(list rez, int c, list p)
{
  int i;
  for (i = 1; i <= size(rez); i++)
  {
    if (int(rez[i][1]) == c && equal(rez[i][2], p)) { return(1); }
  }
  return(0);
}

proc hasTriple(list rez, int c, list p, list q)
{
  int i;
  for (i = 1; i <= size(rez); i++)
  {
    if (int(rez[i][1]) == c && equal(rez[i][2], p)
        && equal(rez[i][3], q))
    {
      return(1);
    }
  }
  return(0);
}

if (lrcalcAvailable)
{
  TestSuite("lrcalc.lib", () -> {

    TestCase("LRcoef", () -> {
      // Pieri rule: (2)*(2) contains (4) and (3,1), both with coeff 1
      expectEqual(int(LRcoef(list(4), list(2), list(2))), 1);
      expectEqual(int(LRcoef(list(3,1), list(2), list(2))), 1);
      // c^(3,2,1)_{(2,1),(2,1)} = 2 (example from the library manual)
      expectEqual(int(LRcoef(list(3,2,1), list(2,1), list(2,1))), 2);
      // a vanishing coefficient
      expectEqual(int(LRcoef(list(3,1), list(2), list(1))), 0);
    });

    TestCase("LRskew", () -> {
      list z = list(3,2,1);
      list x = list(2,1);

      list rez = LRskew(z, x);
      expectEqual(size(rez), 3);
      expectEqual(hasEntry(rez, 1, list(3)), 1);
      expectEqual(hasEntry(rez, 2, list(2,1)), 1);
      expectEqual(hasEntry(rez, 1, list(1,1,1)), 1);

      // same, restricted to partitions of length at most 2
      list rez2 = LRskew(z, x, "r", 2);
      expectEqual(size(rez2), 2);
      expectEqual(hasEntry(rez2, 1, list(3)), 1);
      expectEqual(hasEntry(rez2, 2, list(2,1)), 1);
    });

    TestCase("LRmult", () -> {
      list x = list(2,1);

      // (2,1)*(2,1) has 7 terms; spot-check them all
      list rez = LRmult(x, x);
      expectEqual(size(rez), 7);
      expectEqual(hasEntry(rez, 2, list(3,2,1)), 1);
      expectEqual(hasEntry(rez, 1, list(3,3)), 1);
      expectEqual(hasEntry(rez, 1, list(4,2)), 1);
      expectEqual(hasEntry(rez, 1, list(2,2,1,1)), 1);
      expectEqual(hasEntry(rez, 1, list(2,2,2)), 1);
      expectEqual(hasEntry(rez, 1, list(4,1,1)), 1);
      expectEqual(hasEntry(rez, 1, list(3,1,1,1)), 1);

      // restricted to partitions of length at most 2
      list rez2 = LRmult(x, x, "r", 2);
      expectEqual(size(rez2), 2);
      expectEqual(hasEntry(rez2, 1, list(3,3)), 1);
      expectEqual(hasEntry(rez2, 1, list(4,2)), 1);

      // rectangles: (2)*(2) = (4) + (3,1) + (2,2)
      list rez3 = LRmult(list(2), list(2));
      expectEqual(size(rez3), 3);
      expectEqual(hasEntry(rez3, 1, list(4)), 1);
      expectEqual(hasEntry(rez3, 1, list(3,1)), 1);
      expectEqual(hasEntry(rez3, 1, list(2,2)), 1);
    });

    TestCase("LRcoprod", () -> {
      // (2,1) = (2)*(1) + (2,1)*() + (1,1)*(1), all with coeff 1;
      // NOTE: the empty partition is parsed by lrcalc.lib as (0)
      list rez = LRcoprod(list(2,1));
      expectEqual(size(rez), 3);
      expectEqual(hasTriple(rez, 1, list(2), list(1)), 1);
      expectEqual(hasTriple(rez, 1, list(2,1), list(0)), 1);
      expectEqual(hasTriple(rez, 1, list(1,1), list(1)), 1);
    });

    TestCase("LRschubmult", () -> {
      // (1 3 2)*(1 3 2) = (1 4 2 3) + (2 3 1)  [one-line notation]
      list a = list(1,3,2);
      list rez = LRschubmult(a, a);
      expectEqual(size(rez), 2);
      expectEqual(hasEntry(rez, 1, list(1,4,2,3)), 1);
      expectEqual(hasEntry(rez, 1, list(2,3,1)), 1);

      // identity element: (1 3 2)*(1 2 3) = (1 3 2)
      list rez2 = LRschubmult(a, list(1,2,3));
      expectEqual(size(rez2), 1);
      expectEqual(hasEntry(rez2, 1, list(1,3,2)), 1);
    });
  });
}
else
{
  "SKIP: lrcalc.lib test suite -- external programs lrcalc / schubmult not found";
}
$
